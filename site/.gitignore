# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# supabase CLI temp files
supabase/.temp/

# Investor-only assets (served via auth-gated API routes)
private-assets/

# Investor-only data (numbers, ask, assumptions — rendered inside auth-gated page)
private-data/

# card contact-sheet render output (scripts/render-cards.mjs)
.card-preview/
.chrome-render-profile/
# Second isolated profile: the one-pager/portfolio renders must not share a
# profile with the deck renders, or launching one hands the URL to the other
# and Chrome exits without writing a file.
.chrome-onepager-profile/
.brief-render.html
