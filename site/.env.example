# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (contract generation via Claude Haiku) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- App URLs (used by the A2A agent card; default to the production hosts) ---
NEXT_PUBLIC_MARKETING_URL=https://ambr.run
NEXT_PUBLIC_PLATFORM_URL=https://getamber.dev

# --- Receiving wallet (Base L2) ---
NEXT_PUBLIC_WALLET_ADDRESS=0x...

# --- cNFT (Base L2) ---
CNFT_CONTRACT_ADDRESS=0x...
CNFT_MINTER_PRIVATE_KEY=0x...
# Same contract address, exposed to the browser for the cNFT viewer
NEXT_PUBLIC_CNFT_CONTRACT_ADDRESS=0x...

# --- Stripe ---
# Live or test secret key (sk_live_... for prod, sk_test_... for dev)
STRIPE_SECRET_KEY=sk_...
# Publishable key; the activate page checks for pk_live_ to enable card checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
# Signing secret for /api/v1/stripe/webhook signature verification
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (outbound email, DKIM-signed from ambr.run) ---
RESEND_API_KEY=re_...
# Signing secret for /api/v1/resend/webhook signature verification (Svix).
# Created with the endpoint at https://resend.com/webhooks — subscribe to
# email.delivered / bounced / complained / opened / clicked.
RESEND_WEBHOOK_SECRET=whsec_...

# --- Admin ---
# Bearer token required by /api/v1/admin/* endpoints (64-char hex)
ADMIN_SECRET=
# Comma-separated admin and tech-admin email allowlists
ADMIN_EMAILS=
TECH_ADMIN_EMAILS=
# Team member map used to attribute admin actions (see src/lib/team-members.ts for the format)
TEAM_MEMBER_MAP=

# --- LLM providers (contract drafting and chat) ---
# Active provider and whether to fall back to the other one on failure
LLM_PROVIDER=
LLM_FALLBACK_ENABLED=
MOONSHOT_API_KEY=
KIMI_THINKING_ENABLED=
# Daily USD cap for the in-dashboard AI chat budget
AMBR_AGENT_DAILY_USD_CAP=
# Shows the experimental agent panel in the dashboard when "true"
NEXT_PUBLIC_AMBR_AGENT_EXPERIMENTAL=

# --- Identity (Privy) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- DACS signing and attribute vetting ---
# Signer key for DACS attestations
DACS_SIGNER_KEY=
# Set to "true" with DEMOS_RPC_URL to use the live Demos vet adapter
DACS_VET_LIVE=
DEMOS_RPC_URL=

# --- Investor area ---
# Password hash and cookie secret for /api/v1/investors/verify
INVESTOR_ACCESS_PASSWORD_HASH=
INVESTOR_COOKIE_SECRET=
# Share token for the mobile deck link (/m/<token>)
INVESTOR_DECK_SHARE_TOKEN=

# --- Card rendering scripts (scripts/render-cards.mjs, optional) ---
# CARD_BASE=http://127.0.0.1:4402
# CARD_OUT=.card-preview

# --- Ops Agent bridge (Google Apps Script) ---
# Deployed web-app URL and API key used by /api/health + /api/ops/*
OPS_BASE=https://script.google.com/macros/s/AKfycb.../exec
OPS_KEY=amb-ops-...

# --- x402 v2 pay-per-contract (lib/x402) ---
# Recipient is NEXT_PUBLIC_WALLET_ADDRESS (above).
# CAIP-2 network. Default: eip155:84532 (Base Sepolia) outside production, eip155:8453 (Base) in production.
X402_NETWORK=
# Set to 1 only on a staging deploy that runs production mode against a testnet; otherwise a non-Base-mainnet X402_NETWORK is refused in production.
X402_ALLOW_TESTNET=
# Facilitator that verifies and settles payments. Default outside production: https://x402.org/facilitator (testnet only).
# REQUIRED in production, otherwise paid requests get 503 payment_unavailable.
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402 (needs the two CDP credentials below).
X402_FACILITATOR_URL=
# Coinbase CDP API key, used to sign facilitator requests when X402_FACILITATOR_URL is the CDP facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
